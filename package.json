{
  "name": "spec9",
  "version": "0.1.0",
  "description": "Domain-addressable specification engine and review tooling",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RoboNET/Spec9.git"
  },
  "homepage": "https://github.com/RoboNET/Spec9#readme",
  "bugs": {
    "url": "https://github.com/RoboNET/Spec9/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "spec9": "plugins/spec9/tools/spec.mjs"
  },
  "exports": {
    "./graph": "./plugins/spec9/tools/graph.mjs",
    "./review": "./plugins/spec9/tools/semantic-review.mjs",
    "./impact": "./plugins/spec9/tools/review-impact.mjs",
    "./change": "./plugins/spec9/tools/change.mjs",
    "./next": "./plugins/spec9/tools/next.mjs",
    "./flow": "./plugins/spec9/tools/flow.mjs",
    "./lint": "./plugins/spec9/tools/lint.mjs",
    "./draft": "./plugins/spec9/tools/draft.mjs"
  },
  "files": [
    "plugins/spec9/tools/",
    "!plugins/spec9/tools/**/*.test.mjs",
    "plugins/spec9/docs/format.md",
    "plugins/spec9/examples/",
    "plugins/spec9/constitution.md",
    "README.md"
  ],
  "scripts": {
    "test": "node --test plugins/spec9/tools/*.test.mjs plugins/spec9/tools/adapters/*.test.mjs scripts/*.test.mjs",
    "validate:skill": "npm run validate:skills",
    "validate:skills": "node scripts/validate-distribution.mjs",
    "validate:self": "node plugins/spec9/tools/spec.mjs --spec-root spec9 --product-root . lint",
    "validate": "npm run validate:skills && npm run validate:self && npm test"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  }
}
